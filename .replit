modules = ["python-3.11", "nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DocFlow API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DocFlow CLI"

[[workflows.workflow]]
name = "DocFlow API Server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py serve --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "DocFlow CLI"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py process test_invoice.txt"

[deployment]
run = ["sh", "-c", "python main.py serve --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 8000
externalPort = 80
